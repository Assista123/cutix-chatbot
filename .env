# Copy this file to a new file named .env  (no .example) and edit it in Notepad.
# NEVER share the .env file or post your key anywhere.

PROVIDER=gemini
# Change to: PROVIDER=gemini   once your key is added below.
# For production later (paid): PROVIDER=openai
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=gsk_...
#   OPENAI_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=AQ.Ab8RN6JR6GyfB50YRr4pCYYe3nqQqEQBmZcZr6cEJKJnmZFfzQ
GEMINI_MODEL=gemini-3.1-flash-lite
# Run  python list_models.py  to see the exact model names your key can use.
# If answers come back cut off or empty, try adding:
# GEMINI_EXTRA_JSON={"thinkingConfig":{"thinkingBudget":0}}

# Limits (keep requests under your free-tier limits)
RPM_LIMIT=12
MAX_MSGS_PER_SESSION=20
MAX_MSGS_PER_IP=40
DAILY_CAP=300

# Conversation history sent to the model (V2 default: 4)
HISTORY_WINDOW=4

# Optional: ask visitors for a code before they can chat
ACCESS_CODE=

# Optional small line shown at the bottom of the chat, e.g. Built by YourBusiness
POWERED_BY="Assista Tech Concepts"

# Contact email shown at the bottom of the chat page
CONTACT_EMAIL=Theassistagroup@gmail.com

# 127.0.0.1 = only this computer. 0.0.0.0 = other devices on your Wi-Fi (e.g. your phone) can open it.
HOST=127.0.0.1
PORT=8000

# Later, for other providers:
# PROVIDER=claude   ANTHROPIC_API_KEY=   CLAUDE_MODEL=claude-haiku-5-5
# PROVIDER=openai   OPENAI_API_KEY=   OPENAI_BASE_URL=https://api.deepseek.com   OPENAI_MODEL=deepseek-chat
# (Groq uses the same openai path — see note at top)
